# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.

# Notion 인티그레이션 토큰 (소스 DB를 이 인티그레이션에 공유해야 한다)
NOTION_API_KEY=

# 투두 소스 data source ID (Notion-Version 2025-09-03 기준)
NOTION_DATA_SOURCE_ID=

# webhook X-Notion-Signature HMAC 검증용 시크릿
NOTION_WEBHOOK_SECRET=

# 클라이언트(위젯) → 중계 서버 인증 키
CLIENT_API_KEY=

# 중계 서버 바인딩 — loopback 유지, 외부 노출은 인증 프록시 경유
PORT=8787
HOST=127.0.0.1
