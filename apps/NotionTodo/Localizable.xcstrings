    },
    "Touch and hold a memo, then drag it here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 길게 눌러 여기로 끌어다 놓으세요."
          }
        }
      }
    },
    "Touch and hold the Home Screen, tap Edit → Add Widget, and choose Todo Widget.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면을 길게 누르고 편집 → 위젯 추가에서 ‘할 일 위젯’을 고르세요."
          }
        }
      }
    },
    "Touch and hold the Lock Screen, tap Customize → Lock Screen, then add Memos. You can check items off without unlocking.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면을 길게 누르고 사용자화 → 잠금 화면에서 ‘메모’ 위젯을 추가하세요. 잠금을 풀지 않고도 체크할 수 있어요."
          }
        }
      }
    },
    "Uncheck": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크 해제"
          }
        }
      }
    },
    "Unchecked": {
      "localizations": {
