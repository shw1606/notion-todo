      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Don’t see yours? Select it in Notion…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안 보이나요? Notion에서 고르기…"
